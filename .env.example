# ===== Application =====
SAVIA_ENV=dev                         # dev | ci | staging | prod

# ===== LLM (provider interchangeable) =====
SAVIA_LLM_PROVIDER=openai             # openai | anthropic
SAVIA_LLM_MODEL=gpt-4.1-mini
SAVIA_LLM_TEMPERATURE=0
SAVIA_LLM_TIMEOUT_S=30
SAVIA_LLM_MAX_RETRIES=2
SAVIA_EMBEDDINGS_MODEL=text-embedding-3-small

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== LangSmith =====
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=savia-dev           # un projet PAR environnement
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_TRACING_SAMPLING_RATE=1.0        # 1.0 en dev, à baisser en prod
